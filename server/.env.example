# Porta da API
PORT=3000

# Segredo do JWT (mínimo de 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origem permitida no CORS ("*" libera todas)
CORS_ORIGIN=http://localhost:5174

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=helpdesk
DB_PASSWORD=
DB_NAME=helpdesk
DB_POOL_LIMIT=10

# Obrigatórios em produção. Proxy deve remover headers encaminhados do cliente.
PUBLIC_ORIGIN=https://api.example.com
TRUSTED_PROXIES=
# Ativar depois no serviço, sem versionar o valor real.
SENTRY_DSN=
APP_RELEASE=

# Docker Compose exige senha própria, além de JWT_SECRET e DB_PASSWORD.
MYSQL_ROOT_PASSWORD=

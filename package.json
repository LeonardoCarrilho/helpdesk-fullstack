{
  "name": "helpdesk-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Helpdesk full-stack: React, Node/Express, MySQL, JWT e controle de acesso por papéis",
  "author": "Leonardo Fernandes Carrilho",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server && npm run test --workspace web",
    "build": "npm run build --workspace web",
    "build:demo": "npm run build:demo --workspace web"
  },
  "engines": {
    "node": ">=20.19"
  }
}
